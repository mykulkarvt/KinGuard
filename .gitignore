# Runtime database (created + seeded automatically on first run)
kinguard.db
*.db
*.db.bak

# Packaged snapshot / build artifacts
*.zip
*.aab
*.apk

# Android signing material — NEVER commit these.
# signing.keystore is the private key for the Play listing and
# signing-key-info.txt holds its passwords. Anyone with both can publish an
# update to com.kinguard.app as if they were the developer. A signing key
# cannot be rotated once an app is live, so a leak is permanent.
*.keystore
*.jks
signing-key-info.txt

# Stray copy of the Digital Asset Links file. The served one is
# static/assetlinks.json; this root copy is PWABuilder's original.
/assetlinks.json

# Local environment files. Secrets live in the host's env vars, but if a
# .env is ever created locally it must never be committed.
.env
.env.*

# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db
